+// Each link block starts with what it is.
+static unsigned char const LINK_KIND_BLOCK = 1;
+static unsigned char const LINK_KIND_SYNC = 2;
+
+// Sends bc bytes from hl and puts the partner's bc bytes at de, then leaves hl and de past
+// them and bc at 0, as the game's own exchange routine does. With no partner block, the bytes
+// read as "no data" so the game reports a link error instead of hanging.
+void CPU::runLinkBlockHook(unsigned long &cycleCounter) {
+#ifdef HAVE_NETWORK
+	unsigned const count = bc();
+	unsigned const from = hl();
+	unsigned const to = de();
+	std::vector<unsigned char> out(count + 1);
+	out[0] = LINK_KIND_BLOCK;
+	for (unsigned i = 0; i < count; ++i)
+		out[1 + i] = mem_.read((from + i) & 0xFFFF, cycleCounter);
+	std::vector<unsigned char> in;
+	bool const received = mem_.exchangeLinkBlock(&out[0], count + 1, in)
+		&& !in.empty() && in[0] == LINK_KIND_BLOCK;
+	if (getenv("GAMBATTE_LINK_TRACE"))
+		fprintf(stderr, "[link] block %u bytes, got %d\n", count, received ? (int) in.size() - 1 : -1);
+	for (unsigned i = 0; i < count; ++i)
+		mem_.write((to + i) & 0xFFFF, received && i + 1 < in.size() ? in[i + 1] : 0xFE, cycleCounter);
+	unsigned const hlEnd = (from + count) & 0xFFFF;
+	unsigned const deEnd = (to + count) & 0xFFFF;
+	h = hlEnd >> 8;
+	l = hlEnd & 0xFF;
+	d = deEnd >> 8;
+	e = deEnd & 0xFF;
+	b = 0;
+	c = 0;
+	// About as long as the call itself (a call and a return).
+	cycleCounter += 40;
+#endif
+}
+
+void CPU::runLinkSyncHook(unsigned short &pc, unsigned long &cycleCounter) {
+#ifdef HAVE_NETWORK
+	unsigned char out[2] = { LINK_KIND_SYNC, (unsigned char) (mem_.read(linkPlayerAction_, cycleCounter) & 0x0F) };
+	std::vector<unsigned char> in;
+	bool const received = mem_.exchangeLinkBlock(out, 2, in) && in.size() == 2 && in[0] == LINK_KIND_SYNC;
+	if (getenv("GAMBATTE_LINK_TRACE"))
+		fprintf(stderr, "[link] sync sent %u got %d (from %04x)\n", out[1], received ? in[1] : -1,
+		        mem_.read(sp, cycleCounter) | (mem_.read((sp + 1) & 0xFFFF, cycleCounter) << 8));
+	if (received) {
+		mem_.write(linkOtherAction_, in[1] & 0x0F, cycleCounter);
+		mem_.write(linkOtherMode_, in[1] & 0x0F, cycleCounter);
+	} else {
+		mem_.write(linkOtherAction_, 0xFF, cycleCounter);
+		mem_.write(linkTimeoutFrames_, 0xFF, cycleCounter);
+		mem_.write(linkTimeoutFrames_ + 1, 0xFF, cycleCounter);
+	}
+	// Return from the routine.
+	unsigned const low = mem_.read(sp, cycleCounter);
+	unsigned const high = mem_.read((sp + 1) & 0xFFFF, cycleCounter);
+	sp = (sp + 2) & 0xFFFF;
+	pc = (high << 8 | low) & 0xFFFF;
+	cycleCounter += 40;
+#endif
+}
+
