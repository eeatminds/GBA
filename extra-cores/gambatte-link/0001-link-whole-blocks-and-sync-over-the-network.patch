+static unsigned char const BLOCK_MARK = 0xB5;
+// [0, NO_PARTNER_MARK]: nobody is on the other end to answer a block (the app's link bridge
+// says so when no friend is linked), so the waiting game gives up at once.
+static unsigned char const NO_PARTNER_MARK = 0xB6;
+// How long to wait for the partner's block before giving up (the game then reports a link error).
+static int const BLOCK_TIMEOUT_MS = 30000;
+// How long a single byte transfer waits for the other side. A real cable never waits: with
+// nobody answering the byte reads as $FF. The network needs a little time, but a game that has
+// already left the link (back on its map) never answers, and waiting on would freeze ours.
+static int const SEND_REPLY_TIMEOUT_MS = 2500;
+
+// Whether data arrives within ms milliseconds.
+static bool waitReadable(int fd, int ms)
+{
+	fd_set rfds;
+	FD_ZERO(&rfds);
+	FD_SET(fd, &rfds);
+	struct timeval tv;
+	tv.tv_sec = ms / 1000;
+	tv.tv_usec = (ms % 1000) * 1000;
+	return select(fd + 1, &rfds, NULL, NULL, &tv) > 0;
+}
+
+void NetSerial::dropConnection()
+{
+	if (sockfd_ >= 0) {
+		close(sockfd_);
+		sockfd_ = -1;
+	}
+	blocks_.clear();
+}
+
+bool NetSerial::writeAll(unsigned char const *data, size_t len)
+{
+	while (len > 0) {
+#ifdef _WIN32
+		int written = ::send(sockfd_, (char const*) data, (int) len, 0);
+#else
+		ssize_t written = write(sockfd_, data, len);
+#endif
+		if (written <= 0) {
+			gambatte_log(RETRO_LOG_ERROR, "Error writing to socket: %s\n", strerror(errno));
+			dropConnection();
+			return false;
+		}
+		data += written;
+		len -= written;
+	}
+	return true;
+}
+
+bool NetSerial::readAll(unsigned char *data, size_t len)
+{
+	while (len > 0) {
+#ifdef _WIN32
+		int got = recv(sockfd_, (char*) data, (int) len, 0);
+#else
+		ssize_t got = read(sockfd_, data, len);
+#endif
+		if (got <= 0) {
+			gambatte_log(RETRO_LOG_ERROR, "Error reading from socket: %s\n", strerror(errno));
+			dropConnection();
+			return false;
+		}
+		data += got;
+		len -= got;
+	}
+	return true;
+}
+
+bool NetSerial::readBlockAfterMark()
+{
+	unsigned char header[2];
+	if (!readAll(header, 2))
+		return false;
+	unsigned const len = header[0] | (header[1] << 8);
+	std::vector<unsigned char> block(len + (len & 1));
+	if (!block.empty() && !readAll(&block[0], block.size()))
+		return false;
+	block.resize(len);
+	blocks_.push_back(block);
+	return true;
+}
+
+bool NetSerial::readMessage(unsigned char message[2])
+{
+	for (;;) {
+		if (!readAll(message, 2))
+			return false;
+		if (message[1] != BLOCK_MARK)
+			return true;
+		if (!readBlockAfterMark())
+			return false;
+	}
+}
