+// Each link block starts with what it is.
+static unsigned char const LINK_KIND_BLOCK = 1;
+static unsigned char const LINK_KIND_SYNC = 2;
+
+// Sends bc bytes from hl and puts the partner's bc bytes at de, then leaves hl and de past
+// them and bc at 0, as the game's own exchange routine does. With no partner block, the bytes
+// read as "no data" so the game reports a link error instead of hanging.
+void CPU::runLinkBlockHook(unsigned long &cycleCounter) {
+#ifdef HAVE_NETWORK
+	unsigned const count = bc();
+	unsigned const from = hl();
+	unsigned const to = de();
+	std::vector<unsigned char> out(count + 1);
+	out[0] = LINK_KIND_BLOCK;
+	for (unsigned i = 0; i < count; ++i)
+		out[1 + i] = mem_.read((from + i) & 0xFFFF, cycleCounter);
+	std::vector<unsigned char> in;
+	bool const received = mem_.exchangeLinkBlock(&out[0], count + 1, in)
+		&& !in.empty() && in[0] == LINK_KIND_BLOCK;
+	if (getenv("GAMBATTE_LINK_TRACE"))
+		fprintf(stderr, "[link] block %u bytes, got %d\n", count, received ? (int) in.size() - 1 : -1);
+	for (unsigned i = 0; i < count; ++i)
+		mem_.write((to + i) & 0xFFFF, received && i + 1 < in.size() ? in[i + 1] : 0xFE, cycleCounter);
+	unsigned const hlEnd = (from + count) & 0xFFFF;
+	unsigned const deEnd = (to + count) & 0xFFFF;
+	h = hlEnd >> 8;
+	l = hlEnd & 0xFF;
+	d = deEnd >> 8;
+	e = deEnd & 0xFF;
+	b = 0;
+	c = 0;
+	// About as long as the call itself (a call and a return).
+	cycleCounter += 40;
+#endif
+}
+
+void CPU::runLinkSyncHook(unsigned short &pc, unsigned long &cycleCounter) {
+#ifdef HAVE_NETWORK
+	unsigned char out[2] = { LINK_KIND_SYNC, (unsigned char) (mem_.read(linkPlayerAction_, cycleCounter) & 0x0F) };
+	std::vector<unsigned char> in;
+	bool const received = mem_.exchangeLinkBlock(out, 2, in) && in.size() == 2 && in[0] == LINK_KIND_SYNC;
+	if (getenv("GAMBATTE_LINK_TRACE"))
+		fprintf(stderr, "[link] sync sent %u got %d (from %04x)\n", out[1], received ? in[1] : -1,
+		        mem_.read(sp, cycleCounter) | (mem_.read((sp + 1) & 0xFFFF, cycleCounter) << 8));
+	if (received) {
+		mem_.write(linkOtherAction_, in[1] & 0x0F, cycleCounter);
+		mem_.write(linkOtherMode_, in[1] & 0x0F, cycleCounter);
+	} else {
+		mem_.write(linkOtherAction_, 0xFF, cycleCounter);
+		mem_.write(linkTimeoutFrames_, 0xFF, cycleCounter);
+		mem_.write(linkTimeoutFrames_ + 1, 0xFF, cycleCounter);
+	}
+	// Return from the routine.
+	unsigned const low = mem_.read(sp, cycleCounter);
+	unsigned const high = mem_.read((sp + 1) & 0xFFFF, cycleCounter);
+	sp = (sp + 2) & 0xFFFF;
+	pc = (high << 8 | low) & 0xFFFF;
+	cycleCounter += 40;
+#endif
+}
+
 void CPU::process(unsigned long const cycles) {
 	mem_.setEndtime(cycleCounter_, cycles);
 	mem_.updateInput();
@@ -517,6 +587,19 @@ void CPU::process(unsigned long const cycles) {
 		} else while (cycleCounter < mem_.nextEventTime()) {
 			unsigned char opcode;
 
+			if (linkHookCount_ != 0) {
+				if (pc >= 0x4000 && pc < 0x8000 && linkHookAt(pc)) {
+					// The game is about to exchange a whole block byte by byte: do it at once.
+					runLinkBlockHook(cycleCounter);
+					pc = (pc + 3) & 0xFFFF;
+					continue;
+				}
+				if (pc == linkSyncEntry_ && linkSyncEntry_ != 0) {
+					runLinkSyncHook(pc, cycleCounter);
+					continue;
+				}
+			}
+
 			PC_READ(opcode);
 
 			if (skip_) {
diff --git a/libgambatte/src/cpu.h b/libgambatte/src/cpu.h
index 76c29de..6c62007 100644
--- a/libgambatte/src/cpu.h
+++ b/libgambatte/src/cpu.h
@@ -66,6 +66,35 @@ public:
 		mem_.setInputGetter(getInput);
 	}
 #ifdef HAVE_NETWORK
+	/**
+	 * Link block hooks: the game's own calls that exchange a whole block over the link cable
+	 * byte by byte (hl: bytes to send, de: where the partner's go, bc: how many), at [addresses]
+	 * in ROM bank [bank]. There the block goes over the network at once instead, and the call
+	 * is skipped with the registers as it leaves them. Count 0 turns them off.
+	 */
+	void setLinkBlockHooks(unsigned bank, unsigned short const *addresses, unsigned count) {
+		linkHookBank_ = bank;
+		linkHookCount_ = count < 8 ? count : 8;
+		for (unsigned i = 0; i < linkHookCount_; ++i)
+			linkHooks_[i] = addresses[i];
+	}
+
+	/**
+	 * Link sync hook: the game's "wait until both sides know each other's next action" routine
+	 * (in the home bank at [entry]). Over a network its frame counted waits run out, so instead
+	 * each side sends its action ([playerAction]) and waits for the other's, which goes to
+	 * [otherAction] and [otherMode] as the routine leaves it; then the routine returns. With no
+	 * partner, [timeoutFrames] reads as run out ($FFFF), as when the cable is pulled.
+	 */
+	void setLinkSyncHook(unsigned short entry, unsigned short playerAction, unsigned short otherAction,
+	                     unsigned short otherMode, unsigned short timeoutFrames) {
+		linkSyncEntry_ = entry;
+		linkPlayerAction_ = playerAction;
+		linkOtherAction_ = otherAction;
+		linkOtherMode_ = otherMode;
+		linkTimeoutFrames_ = timeoutFrames;
+	}
+
 	void setSerialIO(SerialIO *serial_io) {
 		mem_.setSerialIO(serial_io);
 	}
@@ -105,6 +134,23 @@ private:
 	unsigned hf1, hf2, zf, cf;
 	unsigned char a_, b, c, d, e, /*f,*/ h, l;
 	bool skip_;
+	unsigned linkHookBank_;
