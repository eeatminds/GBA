+#ifdef HAVE_NETWORK
+/* Size of the loaded ROM, to check link block hook addresses against. */
+static size_t link_rom_size = 0;
+
+/* Gold, Silver and Crystal (English): the four calls in Gen2ToGen2LinkComms that exchange the
+ * random numbers, the party, the patch lists and the mail byte by byte (the spots Nintendo's
+ * own wireless re-release hooked too). Over the network each goes across as one block. */
+struct link_block_game
+{
+   const char *title;
+   const char *code;
+   unsigned short exchange_bytes;       /* Serial_ExchangeBytes (home bank) */
+   unsigned short exchange_bytes_local; /* ExchangeBytes (bank $0A), used for the mail */
+   unsigned short hooks[4];
+   /* WaitLinkTransfer (home bank), and the link variables it reads and writes. */
+   unsigned short wait_link_transfer;
+   unsigned short player_action, other_action, other_mode, timeout_frames;
+};
+
+static const struct link_block_game link_block_games[] = {
+   { "PM_CRYSTAL",  "BYTE", 0x075F, 0x43F2, { 0x41C9, 0x41D8, 0x41E7, 0x41FA },
+     0x087D, 0xCF56, 0xCF52, 0xCF51, 0xCF5B },
+   { "POKEMON_GLD", "AAUE", 0x0710, 0x4380, { 0x41C1, 0x41D0, 0x41DF, 0x41F2 },
+     0x082E, 0xCE56, 0xCE52, 0xCE51, 0xCE5B },
+   { "POKEMON_SLV", "AAXE", 0x0710, 0x4380, { 0x41C1, 0x41D0, 0x41DF, 0x41F2 },
+     0x082E, 0xCE56, 0xCE52, 0xCE51, 0xCE5B },
+};
+
+static void apply_link_block_hooks(void)
+{
+   const unsigned bank = 0x0A;
+   const unsigned char *rom = (const unsigned char*)gb.rombank0_ptr();
+   size_t i;
+
+   gb.setLinkBlockHooks(0, NULL, 0);
+   gb.setLinkSyncHook(0, 0, 0, 0, 0);
+   if (gb_serialMode == SERIAL_NONE || !rom || link_rom_size < (bank + 1) * 0x4000)
+      return;
+
+   for (i = 0; i < sizeof(link_block_games) / sizeof(link_block_games[0]); i++)
+   {
+      const struct link_block_game *game = &link_block_games[i];
+      size_t title_len = strlen(game->title);
+      unsigned h;
+      bool ok = memcmp(rom + 0x134, game->title, title_len) == 0
+             && (title_len == 11 || rom[0x134 + title_len] == 0)
+             && memcmp(rom + 0x13F, game->code, 4) == 0;
+
+      /* Each hook must be exactly the expected call in this ROM. */
+      for (h = 0; ok && h < 4; h++)
+      {
+         const unsigned char *at = rom + bank * 0x4000 + (game->hooks[h] - 0x4000);
+         unsigned target = at[1] | (at[2] << 8);
+         ok = at[0] == 0xCD && target == (h < 3 ? game->exchange_bytes : game->exchange_bytes_local);
+      }
+
+      /* WaitLinkTransfer starts "ld a, $ff; ld [wOtherPlayerLinkAction], a". */
+      if (ok)
+      {
+         const unsigned char *wait = rom + game->wait_link_transfer;
+         ok = wait[0] == 0x3E && wait[1] == 0xFF && wait[2] == 0xEA
+           && (wait[3] | (wait[4] << 8)) == game->other_action;
+      }
+
+      if (ok)
+      {
+         gb.setLinkBlockHooks(bank, game->hooks, 4);
+         gb.setLinkSyncHook(game->wait_link_transfer, game->player_action, game->other_action,
+               game->other_mode, game->timeout_frames);
+         gambatte_log(RETRO_LOG_INFO, "Link: whole-block exchanges for %s\n", game->title);
+         return;
+      }
+   }
+}
+#endif
