+
+bool NetSerial::exchangeBlock(unsigned char const *out, unsigned len, unsigned char sb,
+                              std::vector<unsigned char> &in)
+{
+	if (is_stopped_ || len > 0xFFFF)
+		return false;
+	if (sockfd_ < 0 && !checkAndRestoreConnection(true))
 		return false;
-	}
 
+	std::vector<unsigned char> frame(4 + len + (len & 1), 0);
+	frame[1] = BLOCK_MARK;
+	frame[2] = len & 0xFF;
+	frame[3] = (len >> 8) & 0xFF;
+	for (unsigned i = 0; i < len; ++i)
+		frame[4 + i] = out[i];
+	if (!writeAll(&frame[0], frame.size()))
+		return false;
+
+	int waited = 0;
+	while (blocks_.empty()) {
+		if (waited >= BLOCK_TIMEOUT_MS)
+			return false;
+		if (!waitReadable(sockfd_, 100)) {
+			waited += 100;
+			continue;
+		}
+		unsigned char message[2];
+		if (!readAll(message, 2))
+			return false;
+		if (message[1] == BLOCK_MARK) {
+			if (!readBlockAfterMark())
+				return false;
+		} else if (message[1] == NO_PARTNER_MARK) {
+			return false;
+		} else {
+			// The partner started a single byte transfer before reaching its block: answer it
+			// as the cable would, with what our game last put out.
+			unsigned char reply[2] = { sb, 128 };
+			if (!writeAll(reply, 2))
+				return false;
+		}
+	}
+	in = blocks_.front();
+	blocks_.pop_front();
 	return true;
 }
