-
-//	slave_txn_cnt++;
+	if (buffer[1] == NO_PARTNER_MARK)
+		return false;
 
 	in = buffer[0];
 	fastCgb = buffer[1];
 
 	buffer[0] = out;
 	buffer[1] = 128;
-   #ifdef _WIN32
-      if (::send(sockfd_, (char*) buffer, 2, 0) <= 0)
-   #else
-   	if (write(sockfd_, buffer, 2) <= 0)
-   #endif
-   {
-		gambatte_log(RETRO_LOG_ERROR, "Error writing to socket: %s\n", strerror(errno));
-		close(sockfd_);
-		sockfd_ = -1;
+	return writeAll(buffer, 2);
